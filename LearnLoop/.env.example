# ===================================================
# LearnLoop Environment Variables Configuration
# ===================================================

# Server Port
PORT=3001

# AI Provider Configuration
# Supported providers: openai, gemini, openrouter, custom
AI_PROVIDER=gemini

# API Key for your AI Provider (kept strictly server-side, never exposed to browser)
AI_API_KEY=YOUR_API_KEY

# AI Model Identifier
# Examples:
# For OpenAI: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# For Gemini: gemini-2.0-flash, gemini-1.5-flash
# For OpenRouter: meta-llama/llama-3.3-70b-instruct, anthropic/claude-3.5-haiku
AI_MODEL=gemini-3.8-flash

# Custom AI Base URL (optional)
# For Gemini OpenAI-compatible endpoint: https://generativelanguage.googleapis.com/v1beta/openai/
# For OpenRouter: https://openrouter.ai/api/v1
# For Ollama: http://localhost:11434/v1
# Leave empty for default OpenAI endpoint (https://api.openai.com/v1)
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
